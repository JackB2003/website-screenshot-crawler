# Copy to .env (Docker Compose reads it). Every value is optional.
PORT=3012
# Required when HOST is not localhost. Generate one with: openssl rand -hex 24
AUTH_TOKEN=
# Only enable on your own machine, never on a shared server.
ALLOW_PRIVATE_URLS=false
MAX_PAGES_LIMIT=200
MAX_CONCURRENT_SCANS=2
SCANS_PER_HOUR_PER_CLIENT=20
SCAN_TIMEOUT_MINUTES=30
